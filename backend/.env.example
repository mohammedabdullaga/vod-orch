DATABASE_URL=sqlite:///./ingestion.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
ADMIN_USERNAME=admin
# Set a unique password of at least 12 characters; do not use this example value.
ADMIN_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
SESSION_TTL_SECONDS=28800
# Set true behind HTTPS in production; leave false for local HTTP development.
SESSION_COOKIE_SECURE=false
POLL_INTERVAL_SECONDS=300
WORKER_POLL_SECONDS=2
MAX_RETRIES=5
REQUEST_TIMEOUT_SECONDS=30
REMOTE_JOB_TIMEOUT_SECONDS=86400
DEFAULT_AXEL_CONNECTIONS=12
# Browser origins allowed by the API (comma-separated, exact origins only).
CORS_ORIGINS=http://localhost:5173
# SSH must use a host key present in this file or the system known_hosts.
SSH_KNOWN_HOSTS=
